{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "custom_action": {
      "enum": ["DisableNode", "NodeOverride", "ResetCount", "SubTask", "BBQv2Custom"]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/DisableNode"
    },
    {
      "$ref": "#/$defs/NodeOverride"
    },
    {
      "$ref": "#/$defs/ResetCount"
    },
    {
      "$ref": "#/$defs/SubTask"
    },
    {
      "$ref": "#/$defs/BBQv2Custom"
    }
  ],
  "$defs": {
    "RequiredParam": {
      "anyOf": [
        {
          "required": ["custom_action_param"]
        },
        {
          "required": ["custom_action_param_code"]
        }
      ]
    },
    "DataOnlyAction": {
      "description": "数据节点：只有custom_action_param，没有custom_action，用于存放其他action读取的数据",
      "properties": {
        "custom_action": false,
        "custom_action_param": {
          "type": "object"
        }
      },
      "required": ["custom_action_param"]
    },
    "DisableNode": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "DisableNode",
          "description": "将特定 node 设置为 disable 状态 。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "node_name": {
              "type": "string",
              "description": "需要设置为 disable 状态的节点名称"
            }
          },
          "required": ["node_name"],
          "unevaluatedProperties": false
        }
      }
    },
    "NodeOverride": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "NodeOverride",
          "description": "在 node 中执行 pipeline_override 。"
        },
        "custom_action_param": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "description": "节点覆盖配置，键为节点名称，值为覆盖参数对象",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "ResetCount": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "ResetCount",
          "description": "重置指定节点的命中计数。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "description": "需要重置命中计数的节点名称列表",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "strict": {
              "type": "boolean",
              "description": "任一节点重置失败时，当前 action 是否视为失败",
              "default": false
            }
          },
          "required": ["nodes"],
          "unevaluatedProperties": false
        }
      }
    },
    "SubTask": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "SubTask",
          "description": "按顺序执行 custom_action_param.sub 中的子任务。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "description": "按顺序执行的子任务名称列表",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "continue": {
              "type": "boolean",
              "description": "任一子任务失败后是否继续执行后续子任务",
              "default": false
            },
            "strict": {
              "type": "boolean",
              "description": "任一子任务失败时，当前 action 是否视为失败",
              "default": true
            }
          },
          "required": ["sub"],
          "unevaluatedProperties": false
        }
      }
    },
    "BBQv2Custom": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "BBQv2Custom",
          "description": "基于 token 调度的烧烤自定义动作，参照 Kotlin BbqPlanner 逻辑。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "position_1": {
              "type": "string",
              "description": "位置1的食材名称",
              "default": "肉丸"
            },
            "position_2": {
              "type": "string",
              "description": "位置2的食材名称",
              "default": "骨髓"
            },
            "position_3": {
              "type": "string",
              "description": "位置3的食材名称",
              "default": "糍粑"
            },
            "position_4": {
              "type": "string",
              "description": "位置4的食材名称",
              "default": "豆角"
            },
            "position_5": {
              "type": "string",
              "description": "位置5的食材名称",
              "default": "海鲜"
            },
            "cook_time_肉丸": {
              "type": "number",
              "description": "肉丸烧烤时长(秒)",
              "default": 4.0
            },
            "cook_time_骨髓": {
              "type": "number",
              "description": "骨髓烧烤时长(秒)",
              "default": 6.25
            },
            "cook_time_糍粑": {
              "type": "number",
              "description": "糍粑烧烤时长(秒)",
              "default": 3.0
            },
            "cook_time_豆角": {
              "type": "number",
              "description": "豆角烧烤时长(秒)",
              "default": 2.0
            },
            "cook_time_海鲜": {
              "type": "number",
              "description": "海鲜烧烤时长(秒)",
              "default": 5.0
            },
            "cook_time_巫彭": {
              "type": "number",
              "description": "巫彭烧烤时长(秒)",
              "default": 5.9
            },
            "drink_position_1": {
              "type": "string",
              "description": "饮料位置1的饮料名称",
              "default": "红蓼桃桃"
            },
            "drink_position_2": {
              "type": "string",
              "description": "饮料位置2的饮料名称",
              "default": "广陵山泉"
            },
            "enable_second_grill": {
              "type": "boolean",
              "description": "是否启用第二个烧烤架",
              "default": false
            },
            "max_duration": {
              "type": "number",
              "description": "最大会话时长(秒)",
              "default": 600
            },
            "drink_select_delay": {
              "type": "number",
              "description": "饮料选择后延迟(毫秒)",
              "default": 300
            },
            "delivery_settle": {
              "type": "number",
              "description": "连续交付间隔延迟(毫秒)",
              "default": 300
            },
            "pending_timeout": {
              "type": "number",
              "description": "PENDING_CONFIRM状态超时清除时间(毫秒)",
              "default": 5000
            },
            "cleanup_delay": {
              "type": "number",
              "description": "客人全部交付后自动清理延迟(毫秒)",
              "default": 1000
            }
          }
        }
      }
    }
  }
}

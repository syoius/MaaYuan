{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maayuan:schema:operator-growth-exchange:v3",
  "title": "密探养成数据交换协议 v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "exported_at", "producer", "accounts", "records"],
  "properties": {
    "format": { "const": "myshare-operator-exchange" },
    "version": { "const": 3 },
    "exported_at": { "$ref": "#/$defs/timestamp" },
    "catalog_version": { "type": "string", "maxLength": 128 },
    "producer": { "$ref": "#/$defs/producer" },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/account" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/operatorSnapshotRecord" },
          { "$ref": "#/$defs/annotationListedRecord" },
          { "$ref": "#/$defs/annotationFullRecord" }
        ]
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version"],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "game_scope": { "$ref": "#/$defs/game" }
      }
    },
    "game": {
      "enum": ["如鸢", "代号鸢", "universal"]
    },
    "sourceKind": {
      "enum": ["manual", "scan", "backup", "migration"]
    },
    "baseRecord": {
      "type": "object",
      "required": [
        "account_id",
        "record_id",
        "record_type",
        "game",
        "effective_at",
        "snapshot_scope",
        "source_kind",
        "entries"
      ],
      "properties": {
        "account_id": { "$ref": "#/$defs/identifier" },
        "record_id": { "$ref": "#/$defs/identifier" },
        "game": { "$ref": "#/$defs/game" },
        "effective_at": { "$ref": "#/$defs/timestamp" },
        "source_kind": { "$ref": "#/$defs/sourceKind" }
      }
    },
    "operatorSnapshotRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "type": "object",
          "required": ["record_type", "snapshot_scope", "entries"],
          "properties": {
            "record_type": { "const": "operator_snapshot" },
            "snapshot_scope": { "enum": ["listed", "full"] },
            "coverage": { "$ref": "#/$defs/coverage" },
            "unmatched": {
              "type": "array",
              "items": { "$ref": "#/$defs/unmatchedEntry" }
            },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/$defs/operatorEntry" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "record_count"],
      "properties": {
        "complete": { "type": "boolean" },
        "record_count": { "type": "integer", "minimum": 0 },
        "unmatched_count": { "type": "integer", "minimum": 0 },
        "interrupted": { "type": "boolean" }
      }
    },
    "operatorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id"],
      "properties": {
        "operator_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "elite": { "type": "integer", "minimum": 0, "maximum": 17 },
        "star_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Catalog-aware Huaji scalar: regular operators use 0..31 node encoding; SP operators use 0..5 as direct stars."
        },
        "disc_loadouts": { "$ref": "#/$defs/discLoadouts" },
        "equipped_star_stones": { "$ref": "#/$defs/equippedStarStones" },
        "combat_stats": { "$ref": "#/$defs/combatStats" },
        "section_status": { "$ref": "#/$defs/sectionStatus" },
        "match": { "$ref": "#/$defs/match" },
        "diagnostics": { "type": "object" },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 512 }
        }
      },
      "anyOf": [
        { "required": ["level"] },
        { "required": ["elite"] },
        { "required": ["star_level"] },
        { "required": ["disc_loadouts"] },
        { "required": ["equipped_star_stones"] },
        { "required": ["combat_stats"] }
      ]
    },
    "discLoadouts": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/discLoadout" }
    },
    "discLoadout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "discs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "discs": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ot_name"],
            "properties": {
              "ot_name": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      }
    },
    "equippedStarStones": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/equippedStarStone" }
    },
    "equippedStarStone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level"],
      "properties": {
        "type": { "enum": ["main1", "main2", "main3", "assist1", "assist2", "assist3"] },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "stone_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "level": { "type": "integer", "minimum": 1, "maximum": 60 }
      },
      "anyOf": [
        { "required": ["stone_id"] },
        { "required": ["name"] }
      ]
    },
    "combatStats": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "observed_attack": { "type": ["number", "null"], "minimum": 0 },
        "observed_hp": { "type": ["number", "null"], "minimum": 0 },
        "manual_attack": { "type": ["number", "null"], "minimum": 0 },
        "manual_hp": { "type": ["number", "null"], "minimum": 0 },
        "display_mode": { "$ref": "#/$defs/combatDisplayMode" },
        "source": { "enum": ["scan", "manual", "imported"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "observed_status": { "enum": ["valid", "stale", "unverified", "unavailable"] },
        "combat_input_signature": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observed_inputs": { "$ref": "#/$defs/observedInputs" },
        "oddities": { "$ref": "#/$defs/oddityValues" }
      }
    },
    "observedInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "elite": { "type": "integer", "minimum": 0, "maximum": 17 },
        "star_level": { "type": "integer", "minimum": 0, "maximum": 31 },
        "oddities_signature": { "type": "string", "minLength": 1, "maxLength": 256 },
        "equipped_star_stones_signature": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "combatDisplayMode": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "attack": { "enum": ["auto", "manual", null] },
        "hp": { "enum": ["auto", "manual", null] }
      }
    },
    "oddityValues": {
      "type": "object",
      "description": "Oddity values keyed only by stable semantics. Display names come from the public operator catalog.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "attack": { "$ref": "#/$defs/oddityValue" },
        "hp": { "$ref": "#/$defs/oddityValue" },
        "special": { "$ref": "#/$defs/oddityValue" }
      }
    },
    "oddityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current"],
      "properties": {
        "current": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Optional producer diagnostic; it never overrides the catalog-derived authoritative limit."
        }
      }
    },
    "sectionStatusValue": {
      "enum": ["ready", "partial", "review", "unavailable"]
    },
    "sectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "basic": { "$ref": "#/$defs/sectionStatusValue" },
        "huaji": { "$ref": "#/$defs/sectionStatusValue" },
        "oddities": { "$ref": "#/$defs/sectionStatusValue" },
        "combat_stats": { "$ref": "#/$defs/sectionStatusValue" },
        "disc_loadouts": { "$ref": "#/$defs/sectionStatusValue" },
        "equipment": { "$ref": "#/$defs/sectionStatusValue" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "confidence"],
      "properties": {
        "status": { "enum": ["ready", "review", "unmatched"] },
        "method": { "enum": ["id", "name", "disc", "manual", "unconfirmed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_name": { "type": "string", "maxLength": 256 },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "unmatchedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_name"],
      "properties": {
        "raw_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "diagnostics": { "type": "object" }
      }
    },
    "annotationListedRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "type": "object",
          "required": ["record_type", "snapshot_scope", "entries"],
          "properties": {
            "record_type": { "const": "operator_annotation_snapshot" },
            "snapshot_scope": { "const": "listed" },
            "source_kind": { "enum": ["manual", "backup", "migration"] },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/annotationListedEntry" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "annotationFullRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "type": "object",
          "required": ["record_type", "snapshot_scope", "entries"],
          "properties": {
            "record_type": { "const": "operator_annotation_snapshot" },
            "snapshot_scope": { "const": "full" },
            "source_kind": { "enum": ["backup", "migration"] },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/$defs/annotationFullEntry" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "annotationListedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id"],
      "properties": {
        "operator_id": { "$ref": "#/$defs/identifier" },
        "growth_state": { "$ref": "#/$defs/growthState" },
        "favorite": { "type": "boolean" },
        "note": { "type": ["string", "null"], "maxLength": 1000 },
        "targets": {
          "oneOf": [
            { "$ref": "#/$defs/targets" },
            { "type": "null" }
          ]
        },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "anyOf": [
        { "required": ["growth_state"] },
        { "required": ["favorite"] },
        { "required": ["note"] },
        { "required": ["targets"] }
      ]
    },
    "annotationFullEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "growth_state", "favorite", "note", "targets"],
      "properties": {
        "operator_id": { "$ref": "#/$defs/identifier" },
        "growth_state": { "$ref": "#/$defs/growthState" },
        "favorite": { "type": "boolean" },
        "note": { "type": ["string", "null"], "maxLength": 1000 },
        "targets": {
          "oneOf": [
            { "$ref": "#/$defs/targets" },
            { "type": "null" }
          ]
        },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "growthState": {
      "enum": ["active", "graduated", "skip"]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "elite": { "type": "integer", "minimum": 0, "maximum": 17 },
        "star_level": { "type": "integer", "minimum": 0, "maximum": 31 },
        "heart_paper": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    }
  }
}

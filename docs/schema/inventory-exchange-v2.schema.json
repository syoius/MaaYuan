{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaaYuan Share Inventory Exchange Protocol v2",
  "type": "object",
  "required": ["format", "version", "exported_at", "producer", "records"],
  "properties": {
    "format": {
      "const": "myshare-inventory-exchange"
    },
    "version": {
      "const": 2
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rewardRecord"
          },
          {
            "$ref": "#/$defs/fullSnapshotRecord"
          },
          {
            "$ref": "#/$defs/listedSnapshotRecord"
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "account": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/accountId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": true
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entityType": {
      "enum": ["item", "agent"]
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "rewardEntry": {
      "type": "object",
      "required": ["id", "count"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": true
    },
    "snapshotEntry": {
      "type": "object",
      "required": ["id", "count"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "additionalProperties": true
    },
    "rewardRecord": {
      "type": "object",
      "required": [
        "account_id",
        "record_id",
        "record_type",
        "entity_type",
        "effective_at",
        "entries"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/accountId"
        },
        "record_id": {
          "$ref": "#/$defs/recordId"
        },
        "record_type": {
          "const": "reward_delta"
        },
        "entity_type": {
          "$ref": "#/$defs/entityType"
        },
        "acquisition_channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effective_at": {
          "$ref": "#/$defs/effectiveAt"
        },
        "snapshot_scope": false,
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rewardEntry"
          }
        }
      },
      "additionalProperties": true
    },
    "fullSnapshotRecord": {
      "type": "object",
      "required": [
        "account_id",
        "record_id",
        "record_type",
        "entity_type",
        "effective_at",
        "snapshot_scope",
        "entries"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/accountId"
        },
        "record_id": {
          "$ref": "#/$defs/recordId"
        },
        "record_type": {
          "const": "stock_snapshot"
        },
        "entity_type": {
          "$ref": "#/$defs/entityType"
        },
        "acquisition_channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effective_at": {
          "$ref": "#/$defs/effectiveAt"
        },
        "snapshot_scope": {
          "const": "full"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshotEntry"
          }
        }
      },
      "additionalProperties": true
    },
    "listedSnapshotRecord": {
      "type": "object",
      "required": [
        "account_id",
        "record_id",
        "record_type",
        "entity_type",
        "effective_at",
        "snapshot_scope",
        "entries"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/accountId"
        },
        "record_id": {
          "$ref": "#/$defs/recordId"
        },
        "record_type": {
          "const": "stock_snapshot"
        },
        "entity_type": {
          "$ref": "#/$defs/entityType"
        },
        "acquisition_channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effective_at": {
          "$ref": "#/$defs/effectiveAt"
        },
        "snapshot_scope": {
          "const": "listed"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/snapshotEntry"
          }
        }
      },
      "additionalProperties": true
    }
  }
}

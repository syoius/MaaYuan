    "recognition": {
      "type": "OCR",
      "param": {
        "expected": "包",
        "only_rec": true,
        "roi": [5, 173, 94, 55]
      }
    },
    "pre_delay": 500,
    "action": {
      "type": "Click",
      "param": {
        "target_offset": [40, -3, -77, -40]
      }
    },
    "post_delay": 4000
  },
  "背包识别-已在背包页": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": "背包",
        "roi": [293, 108, 134, 79]
      }
    },
    "pre_delay": 500,
    "action": {
      "type": "Click",
      "param": {
        "target": [217, 252, 23, 10]
      }
    },
    "next": ["背包识别-已在物品页"]
  },
  "背包识别-已在物品页": {
    "recognition": {
      "type": "ColorMatch",
      "param": {
        "lower": [221, 182, 135],
        "upper": [241, 203, 155],
        "roi": [164, 238, 126, 36],
        "count": 200
      }
    },
    "pre_delay": 500,
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "PagedItemRecognition",
        "custom_action_param": {
          "index_path": "agent/bag-item-index.npz",
          "inventory_report_path": "StockReport.txt",
          "layout_mode": "auto",
          "roi": [34, 245, 672, 940],
          "top_k": 15,
          "match_threshold": 0.9,
          "match_low_threshold": 0.85,
          "match_min_margin": 0.08,
          "count_min_roi_bottom_distance": 150,
          "swipe_rows": 2,
          "max_pages": 30,
          "acquisition_channel": "背包-物品",
          "snapshot_list": "tab1",
          "count_mode": "bag_consensus"
        }
      }
    },
    "post_delay": 1500,
    "next": ["背包识别-点击养成页"]
  },
  "背包识别-点击养成页": {
    "action": {
      "type": "Click",
      "param": {
        "target": [487, 251, 26, 13]

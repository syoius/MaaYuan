        "count": 200
      }
    },
    "pre_delay": 500,
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "PagedItemRecognition",
        "custom_action_param": {
          "index_path": "agent/bag-item-index.npz",
          "inventory_report_path": "StockReport.txt",
          "roi": [34, 245, 672, 940],
          "top_k": 20,
          "match_threshold": 0.9,
          "match_low_threshold": 0.8,
          "match_min_margin": 0.08,
